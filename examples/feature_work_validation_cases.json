{
  "version": 1,
  "description": "Manually annotated feature-work tasks for validating AgenVantage first-request context packing.",
  "cases": [
    {
      "case_id": "token-optimization-cli-handoff-json",
      "repository": "token-optimization",
      "budget": 6000,
      "top_k": 28,
      "task": "Add or refine a CLI flag that emits a compact JSON agent handoff with selected chunks, change surface targets, and the rendered prompt.",
      "expected_edit_targets": ["src/agenvantage/cli.py", "src/agenvantage/repo_context.py"],
      "expected_test_targets": ["tests/test_cli.py"],
      "expected_config_targets": [],
      "required_observations": [
        {
          "label": "pack_cli_already_has_output_modes",
          "any_of": [["--stdout", "--json", "--manifest"], ["--handoff-json", "selected_chunks"]]
        },
        {
          "label": "repo_context_report_carries_selected_chunks",
          "any_of": [["selected_chunks", "change_surface"], ["candidate_context_tokens", "selected_context_tokens"]]
        },
        {
          "label": "cli_tests_exercise_pack_command",
          "any_of": [["test_pack", "subprocess"], ["pack", "--json", "json.loads"]]
        }
      ],
      "answer_plan_rubric": [
        "Names the CLI parser and pack execution path as the edit surface.",
        "Names repo_context reporting as the source of selected chunks/change surface data.",
        "Names CLI tests as the validation target."
      ]
    },
